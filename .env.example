# String de conexão do banco Neon que guarda os pacotes de sincronização.
# Sem ela, /api/sync responde 503 e a mesma conta não abre em outro aparelho.
# Copie de console.neon.tech › seu projeto › Connect.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Protege o /api/limpeza chamado pelo cron semanal da Vercel.
CRON_SECRET=
