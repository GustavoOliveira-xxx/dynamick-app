# Banco de dados.
# Desenvolvimento (padrão): SQLite local.
DATABASE_URL="file:./dev.db"
# Produção: troque o provider em prisma/schema.prisma para "postgresql" e use, por exemplo:
# DATABASE_URL="postgresql://usuario:senha@host:5432/dynamick?schema=public"

# Chave HMAC do cookie de sessão. OBRIGATÓRIA em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# Nome exibido do produto (opcional).
NEXT_PUBLIC_APP_NAME="Dynamic CK"

# Senha dos usuários de demonstração criados pelo seed (apenas desenvolvimento).
SEED_DEMO_PASSWORD="demo1234"
